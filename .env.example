# Environment variables for local development ONLY.
# Copy to `.env` and fill in real values. NEVER commit the populated .env.
# Generate secrets locally, e.g.: openssl rand -hex 32

# --- Backend ---
NODE_ENV=development
PORT=4000
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_USER=change_me_nondefault_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=accounting_finance
# REQUIRED, min 32 chars. The app refuses to start without it.
JWT_SECRET=
# Comma-separated exact origins allowed by CORS (no wildcards).
ALLOWED_ORIGINS=http://localhost:3000
IPFS_HOST=ipfs
IPFS_PORT=5001

# --- docker-compose reads these too ---
# Must match POSTGRES_* above.
# Compose will fail with a clear error if unset (see docker-compose.yml).
